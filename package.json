    "@fontsource/poppins": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "chart.js": "4.5.1",
    "sortablejs": "1.15.7",
    "sweetalert2": "11.26.25",
    "tailwindcss": "4.3.3"
  }
}
