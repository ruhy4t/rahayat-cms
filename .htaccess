# Route requests safely when the hosting document root points to this project root.
DirectoryIndex public/index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(\.git|\.sixth)(/|$) - [F,L]
    RewriteRule ^(app|config|database|views|scripts)(/|$) - [F,L]
    # Deny active content in storage BEFORE the catch-all rewrite below, which
    # would otherwise match first and make a later deny rule unreachable.
    RewriteRule ^storage/.*\.(svg|php\d*|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)$ - [F,L,NC]
    RewriteRule ^storage/(.*)$ public/index.php?url=storage/$1 [QSA,L,NC]

    # Otomatis mencari file statis di folder public jika tidak ditemukan di root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(css|js|img|images|fonts|assets|vendor|favicon\.ico)(.*)$ public/$1$2 [L,NC]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

<FilesMatch "^(user\.txt|README\.md|CHANGELOG\.md|CONTRIBUTING\.md|SECURITY\.md|DEPLOYMENT-.*\.md|package\.json|package-lock\.json|version\.json)$">
    Require all denied
</FilesMatch>

# Nothing in the project may serve a backup copy produced by a security patch.
<FilesMatch "(\.bak|\.bak-|~)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|log|ini|sql|bak|config|dist|lock)$">
    Require all denied
</FilesMatch>
